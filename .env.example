JARVIS_APP_NAME=Jarvis
JARVIS_ENVIRONMENT=local
JARVIS_LOG_LEVEL=INFO
JARVIS_DATA_DIR=runtime
JARVIS_WORKSPACE_ROOT=.
JARVIS_JSON_LOGS=true
JARVIS_COMMAND_ALLOWLIST=

# Web providers run server-side as shared tools for both local and online LLMs.
# You.com is the general-search primary, Exa specializes in semantic/technical
# retrieval, Brave remains available, and SearXNG is an optional local service.
YDC_API_KEY=
EXA_API_KEY=
SEARXNG_BASE_URL=http://127.0.0.1:8080
# BRAVE_SEARCH_API_KEY is canonical; JARVIS_BRAVE_SEARCH_API_KEY and
# BRAVE_API_KEY remain supported for compatibility.
BRAVE_SEARCH_API_KEY=
JARVIS_WEB_SEARCH_PROVIDER=brave
JARVIS_WEB_SEARCH_ENABLED=true
JARVIS_WEB_SEARCH_MAX_RESULTS=5
JARVIS_WEB_SEARCH_TIMEOUT_SECONDS=8
JARVIS_WEB_SEARCH_HEALTH_TTL_SECONDS=300
JARVIS_SEARCH_QUICK_MAX_QUERIES=1
JARVIS_SEARCH_NORMAL_MAX_QUERIES=3
JARVIS_SEARCH_DEEP_MAX_QUERIES=10
JARVIS_SEARCH_MAX_RESULTS_PER_QUERY=8
JARVIS_SEARCH_MAX_TOTAL_RESULTS=80
JARVIS_SEARCH_QUICK_MAX_PAGES=3
JARVIS_SEARCH_NORMAL_MAX_PAGES=6
JARVIS_SEARCH_DEEP_MAX_PAGES=12
JARVIS_SEARCH_MAX_BYTES_PER_PAGE=2000000
JARVIS_SEARCH_MAX_EVIDENCE_CHUNKS=36
JARVIS_SEARCH_MAX_CONTEXT_TOKENS=12000
JARVIS_SEARCH_MAX_RESEARCH_ROUNDS=3
JARVIS_SEARCH_REQUEST_TIMEOUT_SECONDS=12
JARVIS_SEARCH_QUERY_CACHE_TTL_SECONDS=120
JARVIS_SEARCH_FETCH_CACHE_TTL_SECONDS=600
JARVIS_SEARCH_MAX_CONCURRENT_QUERIES=3
JARVIS_SEARCH_MAX_CONCURRENT_FETCHES=4
JARVIS_SEARCH_MAX_RATE_LIMIT_BACKOFF_SECONDS=2
JARVIS_SEARCH_MIN_INFORMATION_GAIN=0.08
JARVIS_SEARCH_MAX_STAGNANT_ROUNDS=1
JARVIS_SEARCH_FILE_MAX_RESULTS=30
JARVIS_SEARCH_FILE_MAX_BYTES=300000
JARVIS_RESEARCH_FINAL_ANSWER_MAX_TOKENS=1200
JARVIS_RESEARCH_DEEP_FINAL_MAX_TOKENS=1800
JARVIS_RESEARCH_FINAL_OUTPUT_RESERVE_TOKENS=1800
JARVIS_RESEARCH_MAX_SYNTHESIS_ATTEMPTS=3
JARVIS_RESEARCH_MAX_OUTPUT_CONTINUATIONS=2

# Modelo principal híbrido. La clave real va solo en .env local o en el
# campo seguro de Ajustes; nunca debe escribirse en este archivo de ejemplo.
JARVIS_LLM_MODE=auto
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_REASONING_MIN_COMPLETION_TOKENS=512

# Endpoint OpenAI-compatible que debe anunciar el perfil local Qwen3.5 promovido.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8081/v1
# Exact llama.cpp alias advertised by the managed local server.
LOCAL_LLM_MODEL=Qwen3.5-9B-IQ4_XS
# Optional advertised llama.cpp aliases for the same Qwen3.5 family.
# LOCAL_LLM_MODEL_ALIASES=["Qwen3.5-9B-IQ4_XS"]
JARVIS_LOCAL_RUNTIME_AUTOSTART=true
JARVIS_LOCAL_RUNTIME_MODEL_PATH=models/llm/qwen3.5-9b/Qwen3.5-9B-IQ4_XS.gguf
JARVIS_LOCAL_RUNTIME_PROFILE_ID=qwen35-9b-iq4-xs
JARVIS_LOCAL_RUNTIME_CUDA_BINARY=runtimes/llama-cpp-cuda/llama-server.exe
JARVIS_LOCAL_RUNTIME_VULKAN_BINARY=runtimes/llama-cpp-vulkan/llama-server.exe
JARVIS_LOCAL_RUNTIME_CUDA_BASE_URL=http://127.0.0.1:8081/v1
JARVIS_LOCAL_RUNTIME_VULKAN_BASE_URL=http://127.0.0.1:8080/v1
JARVIS_LOCAL_RUNTIME_READY_TIMEOUT_SECONDS=120
JARVIS_LOCAL_RUNTIME_STOP_ON_SHUTDOWN=true
# Temporary pre-LoRA agent policy: off, compact (PRE-LORA-1), or full (PRE-LORA-2).
JARVIS_PRE_LORA_AGENTIC_PROFILE=full
JARVIS_PRE_LORA_AGENTIC_SCAFFOLD_ENABLED=true
LOCAL_CPU_OFFLOAD_GB=auto
LOCAL_GPU_MEMORY_UTILIZATION=auto
LOCAL_MAX_MODEL_LEN=auto
LOCAL_TENSOR_PARALLEL_SIZE=auto
JARVIS_LOCAL_LOAD_TIMEOUT_SECONDS=900
# stable, balanced, performance o custom. Los límites numéricos anteriores son
# los que se transmiten al backend; auto delega la selección al backend.
JARVIS_LOCAL_PERFORMANCE_PROFILE=stable

# Límites del compositor multimodal.
JARVIS_ATTACHMENT_MAX_FILE_BYTES=52428800
JARVIS_ATTACHMENT_MAX_REQUEST_BYTES=209715200
JARVIS_ATTACHMENT_MAX_FILES_PER_REQUEST=16
JARVIS_ATTACHMENT_PROCESSING_TIMEOUT_SECONDS=120
JARVIS_ATTACHMENT_VIDEO_MAX_FRAMES=12

JARVIS_IMAGE_ENABLED=true
JARVIS_IMAGE_BACKEND=diffusers
JARVIS_IMAGE_MODEL_PATH=models/image/checkpoints/juggernautXL_v8Rundiffusion.safetensors
JARVIS_IMAGE_OUTPUT_DIR=outputs/images
JARVIS_IMAGE_TIMEOUT_SECONDS=1800
